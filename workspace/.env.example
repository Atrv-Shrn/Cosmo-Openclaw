# Template for Cosmo's secrets. Copy this file to .env (git-ignored) and fill in real values.
#
# .env is where every confidential value Cosmo needs lives: API keys, database
# passwords, service tokens, anything secret.
#
# Cosmo is trained to route secrets here automatically. When you connect a new
# service that needs credentials, Cosmo writes those keys into .env and reads
# them at runtime. It never hard-codes them, or pastes them into chat, commits,
# or sub-agent prompts.

# Example: connecting Supabase (database credentials)
# SUPABASE_DB_PASSWORD=CHANGE_ME
# SUPABASE_PROJECT_REF=your_project_ref
# SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_POOLER_PORT=5432

# Example: any other service that needs an API key
# OPENAI_API_KEY=CHANGE_ME
# STRIPE_SECRET_KEY=CHANGE_ME
