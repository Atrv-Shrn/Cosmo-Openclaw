# Secrets — never commit
.env
**/.env
*.pem
*.key

# OpenClaw runtime state (not part of the config)
.openclaw/

# repos/ + db/ hold external code and DB dumps — show the folder, ignore the contents
workspace/repos/*
!workspace/repos/.gitkeep
workspace/db/*
!workspace/db/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db

# Generated reference doc (kept local, not published)
SPEC.md
