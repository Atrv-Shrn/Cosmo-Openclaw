# Secrets — never commit
.env
**/.env
*.pem
*.key

# OpenClaw runtime state (not part of the config)
.openclaw/

# repos/ + db/ hold external code and DB dumps — show the folder + README, ignore the contents
workspace/repos/*
!workspace/repos/README.md
workspace/db/*
!workspace/db/README.md

# OS / editor cruft
.DS_Store
Thumbs.db
